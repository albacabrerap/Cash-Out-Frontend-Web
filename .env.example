# Copiar como .env. Las variables VITE_ se incrustan en el JavaScript publico:
# nunca pongas aqui un secreto (claves de Alpaca, JWT, credenciales de la base).

# Relativa cuando web y API comparten origen (proxy de Vite en local, CloudFront
# en produccion). Absoluta solo si viven en dominios distintos; en ese caso el
# backend debe incluir la web en CORS_ALLOWED_ORIGINS.
VITE_API_URL=/api/v1

# Solo para `npm run dev`: a donde reenvia Vite las peticiones /api.
VITE_DEV_API_TARGET=http://localhost:8080
