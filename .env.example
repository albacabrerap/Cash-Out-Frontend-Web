# Copiar como .env. Las variables VITE_ se incrustan en el JavaScript publico:
# nunca pongas aqui un secreto (claves de Alpaca, JWT, credenciales de la base).

# Siempre relativa: web y API tienen que compartir sitio (proxy de Vite en local,
# rewrite de /api en vercel.json en produccion). El token de refresco viaja en
# una cookie SameSite=Strict, y con la API en otro dominio el navegador no la
# manda: la sesion se cerraria en cada recarga.
VITE_API_URL=/api/v1

# Client ID web de Google para "Continuar con Google" (no es secreto: Google lo
# muestra en la pagina). Vacio, el boton no aparece. Es el mismo GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=

# Solo para `npm run dev`: a donde reenvia Vite las peticiones /api.
VITE_DEV_API_TARGET=http://localhost:8080
